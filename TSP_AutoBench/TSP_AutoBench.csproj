<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TSP_AutoBench</RootNamespace>
    <AssemblyName>TSP_AutoBench</AssemblyName>
  </PropertyGroup>

  <!-- DLL lives at repo-root libs/TSP_CS.Core.dll for this paper repository. -->
  <ItemGroup>
    <Reference Include="TSP_CS.Core">
      <HintPath>..\libs\TSP_CS.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
